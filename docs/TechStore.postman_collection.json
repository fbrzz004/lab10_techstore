{
  "info": {
    "name": "TechStore API",
    "description": "Colección del laboratorio 10. Ejecute las solicitudes en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "producto_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "02 Login válido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Acceso exitoso', function () {",
              "    pm.expect(pm.response.json().ok).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/login"
      }
    },
    {
      "name": "03 Login incorrecto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 401', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"0000\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/login"
      }
    },
    {
      "name": "04 Listar productos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Lista con productos', function () {",
              "    pm.expect(pm.response.json().length).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/productos"
      }
    },
    {
      "name": "05 Buscar laptop",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Una coincidencia', function () {",
              "    pm.expect(pm.response.json().length).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/productos/buscar?q=laptop"
      }
    },
    {
      "name": "06 Buscar sin resultados",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Sin coincidencias', function () {",
              "    pm.expect(pm.response.json().length).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/productos/buscar?q=xyz123"
      }
    },
    {
      "name": "07 Crear producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.collectionVariables.set('producto_id', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"PROD-999\",\n  \"nombre\": \"Producto de prueba\",\n  \"categoria\": \"Pruebas\",\n  \"precio\": 99.9,\n  \"stock\": 2,\n  \"descripcion\": \"Producto temporal para la prueba\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/productos"
      }
    },
    {
      "name": "08 Actualizar producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Producto de prueba editado\",\n  \"categoria\": \"Pruebas\",\n  \"precio\": 109.9,\n  \"stock\": 5,\n  \"descripcion\": \"Producto temporal editado\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/productos/{{producto_id}}"
      }
    },
    {
      "name": "09 Eliminar producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/productos/{{producto_id}}"
      }
    }
  ]
}
